    "smart": {
      "profile": {
        "tier": "flagship",
        "requiredCapabilities": [
          "tool_use",
          "vision"
        ]
      }
    }
  },
  "heartbeat": {
    "enabled": false
  },
  "mcp_servers": {},
  "compute_credentials": {
    "allowed_providers": []
  },
  "capabilities": [
    "video-editing",
    "motion-graphics",
    "reference-remake",
    "audio-mixing",
    "video-quality-review"
  ],
  "trigger_patterns": [
    "视频剪辑",
    "视频剪辑师",
    "剪片",
    "重剪",
    "调色",
    "动效",
    "音频混音",
    "字幕",
    "参考视频"
  ],
  "default_enabled": {
    "skills": [
      "video-editing",
      "edit-video",
      "motion-graphics",
      "remake-reel"
    ]
  },
  "file_security": {
    "restrictToWorkDirs": true
